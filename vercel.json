{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd event-ticket-web && npm install && npm run build",
  "outputDirectory": "event-ticket-web/dist/event-ticket-web/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
