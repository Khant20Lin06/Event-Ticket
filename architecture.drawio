<mxfile host="app.diagrams.net" modified="2026-09-10T05:55:00.000Z" agent="Antigravity Architecture Generator" version="21.6.8" type="device">
  <diagram id="AURA-Enterprise-Architecture" name="AURA High-Concurrency Architecture">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#0B1120" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- MAIN HEADER TITLE -->
        <mxCell id="header-box" value="&lt;b style='font-size: 20px; color: #FFFFFF;'&gt;AURA — ENTERPRISE HIGH-CONCURRENCY EVENT TICKETING PLATFORM&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 13px; color: #94A3B8;'&gt;System Architecture &amp;amp; Distributed Atomic Concurrency Flow (1,000,000+ Concurrent Requests / 0 Over-Selling Guarantee)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#6366F1;strokeWidth=2;shadow=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1480" height="60" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 1: CLIENT PRESENTATION TIER ==================== -->
        <mxCell id="tier1-box" value="&lt;b style='color:#38BDF8; font-size:14px;'&gt;1. PRESENTATION &amp;amp; CLIENT TIER (ANGULAR 19 SPA)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=1.5;strokeOpacity=80;fontColor=#FFFFFF;startSize=30;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="1480" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="client-user" value="&lt;b style='color:#38BDF8; font-size:13px;'&gt;🎬 User Booking Client&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• Interactive SVG Seat Matrix (50 - 300 Seats)&lt;br&gt;• Real-Time Countdown Drawer (5-Min Lock)&lt;br&gt;• Atomic Instant Checkout Modal&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier1-box">
          <mxGeometry x="40" y="42" width="410" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="client-admin" value="&lt;b style='color:#818CF8; font-size:13px;'&gt;🛡️ Operator &amp;amp; Executive Console&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• Cluster Flow Governor (20 - 1,200 req/sec)&lt;br&gt;• Live Seat Inventory Matrix &amp;amp; Tier Pricing&lt;br&gt;• Redis Hot-Path Cache Sync &amp;amp; Metrics&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#818CF8;strokeWidth=1.5;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier1-box">
          <mxGeometry x="535" y="42" width="410" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="client-loadtest" value="&lt;b style='color:#F43F5E; font-size:13px;'&gt;⚡ Stress Test Runners (Autocannon / k6)&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• 1,000,000 Concurrent Requests on Exact Seat&lt;br&gt;• Proves 1 Success (200) &amp;amp; 999,999 Conflicts (409)&lt;br&gt;• Sub-millisecond Redis lock latency benchmark&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F43F5E;strokeWidth=1.5;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier1-box">
          <mxGeometry x="1030" y="42" width="410" height="75" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 2: EDGE & LOAD BALANCING TIER ==================== -->
        <mxCell id="tier2-box" value="&lt;b style='color:#10B981; font-size:14px;'&gt;2. EDGE GATEWAY &amp;amp; LOAD BALANCER TIER (NGINX REVERSE PROXY)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#10B981;strokeWidth=1.5;strokeOpacity=80;fontColor=#FFFFFF;startSize=30;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="1480" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="nginx-lb" value="&lt;b style='color:#10B981; font-size:14px;'&gt;🌐 Nginx Load Balancer (Port 3000 / SSL Reverse Proxy)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px; color:#94A3B8;'&gt;• Dynamic DNS Embedded Resolver (127.0.0.11) with round-robin load distribution across multi-replica API containers&lt;br&gt;• TLS/SSL Termination • Ingress Rate Limiting (60 req/min/IP) • CORS Lockdown &amp;amp; OWASP Security Header Enforcement&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;shadow=1;align=center;" vertex="1" parent="tier2-box">
          <mxGeometry x="240" y="40" width="1000" height="58" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 3: APPLICATION CLUSTER TIER ==================== -->
        <mxCell id="tier3-box" value="&lt;b style='color:#6366F1; font-size:14px;'&gt;3. APPLICATION MICROSERVICES CLUSTER (HORIZONTALLY SCALED NESTJS PODS)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#6366F1;strokeWidth=1.5;strokeOpacity=80;fontColor=#FFFFFF;startSize=30;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="1480" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="api-pod-1" value="&lt;b style='color:#A5B4FC; font-size:13px;'&gt;⚙️ NestJS API Replica 1&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• Auth &amp;amp; JWT RBAC Service&lt;br&gt;• Seat Booking Controller&lt;br&gt;• WebSocket Gateway (/seats)&lt;br&gt;• Global Validation Pipes&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier3-box">
          <mxGeometry x="40" y="42" width="410" height="102" as="geometry"/>
        </mxCell>

        <mxCell id="api-pod-2" value="&lt;b style='color:#A5B4FC; font-size:13px;'&gt;⚙️ NestJS API Replica 2&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• Queue-Room Governor Controller&lt;br&gt;• Distributed Redis Lock Adapter&lt;br&gt;• AI Campaign &amp;amp; Synopsis Generator&lt;br&gt;• BullMQ Queue Producer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier3-box">
          <mxGeometry x="535" y="42" width="410" height="102" as="geometry"/>
        </mxCell>

        <mxCell id="api-pod-n" value="&lt;b style='color:#A5B4FC; font-size:13px;'&gt;⚙️ NestJS API Replica N (Auto-Scaled)&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• Kubernetes HPA (50 - 500 Pods)&lt;br&gt;• Real-time Socket.io Adapter&lt;br&gt;• Health &amp;amp; Liveness Probes (/health)&lt;br&gt;• Event Catalog Service&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier3-box">
          <mxGeometry x="1030" y="42" width="410" height="102" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 4: DISTRIBUTED CONCURRENCY & REDIS TIER ==================== -->
        <mxCell id="tier4-box" value="&lt;b style='color:#EF4444; font-size:14px;'&gt;4. IN-MEMORY CONCURRENCY &amp;amp; ASYNCHRONOUS ENGINE (REDIS HOT-PATH &amp;amp; BULLMQ)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#EF4444;strokeWidth=1.5;strokeOpacity=80;fontColor=#FFFFFF;startSize=30;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1480" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="redis-lock" value="&lt;b style='color:#EF4444; font-size:13px;'&gt;🔒 Redis Distributed Atomic Lock&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• &lt;b style='color:#FCA5A5;'&gt;SET seat:lock:{id} {userId} NX PX 300000&lt;/b&gt;&lt;br&gt;• Guarantees single-ownership in sub-milliseconds&lt;br&gt;• Immediate 409 Conflict rejection for contestants&lt;br&gt;• 100% immune to race conditions / double booking&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EF4444;strokeWidth=2;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier4-box">
          <mxGeometry x="40" y="42" width="430" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="redis-pubsub" value="&lt;b style='color:#F59E0B; font-size:13px;'&gt;📡 Redis Pub/Sub Bus&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• Cross-Pod WebSocket event broadcasting&lt;br&gt;• Publishes &lt;i&gt;'SEAT_STATUS_UPDATED'&lt;/i&gt;&lt;br&gt;• Syncs seat hold/booked/released status&lt;br&gt;• Sub-5ms UI update for all connected fans&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier4-box">
          <mxGeometry x="525" y="42" width="430" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="bullmq-workers" value="&lt;b style='color:#EC4899; font-size:13px;'&gt;⏱️ BullMQ Asynchronous Workers&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• &lt;b&gt;SeatExpirationProcessor:&lt;/b&gt; Delayed 5-min timer auto-releases held seat if checkout abandoned&lt;br&gt;• &lt;b&gt;AsyncDbWriteProcessor:&lt;/b&gt; Buffers booking events for asynchronous database writes during flash sales&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier4-box">
          <mxGeometry x="1010" y="42" width="430" height="95" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 5: PERSISTENCE & CONNECTION POOLING TIER ==================== -->
        <mxCell id="tier5-box" value="&lt;b style='color:#06B6D4; font-size:14px;'&gt;5. PERSISTENCE &amp;amp; CONNECTION POOLING TIER (POSTGRESQL &amp;amp; PGBOUNCER)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#06B6D4;strokeWidth=1.5;strokeOpacity=80;fontColor=#FFFFFF;startSize=30;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1480" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="pgbouncer-box" value="&lt;b style='color:#06B6D4; font-size:13px;'&gt;🛡️ PgBouncer Connection Pooler (Port 6432)&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• Pool Mode: &lt;b style='color:#67E8F9;'&gt;Transaction Pooling&lt;/b&gt; (DEFAULT_POOL_SIZE=100)&lt;br&gt;• Multiplexes thousands of incoming API connections into small stable DB pools&lt;br&gt;• Prevents Postgres RAM starvation &amp;amp; backend connection exhaustion&lt;br&gt;• Seamless support for horizontal pod scaling without modifying database limits&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#06B6D4;strokeWidth=2;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier5-box">
          <mxGeometry x="120" y="42" width="560" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="postgres-box" value="&lt;b style='color:#38BDF8; font-size:13px;'&gt;🗄️ PostgreSQL Relational Database (Port 5433)&lt;/b&gt;&lt;hr style='border:0.5px solid rgba(255,255,255,0.1);'/&gt;&lt;div style='text-align:left; font-size:11px; color:#CBD5E1; line-height:1.4;'&gt;• &lt;b&gt;Relational Schema:&lt;/b&gt; Users, Events, Seats, Bookings&lt;br&gt;• &lt;b&gt;ACID Transactions:&lt;/b&gt; Guaranteed strict financial and ticket booking ledger&lt;br&gt;• &lt;b&gt;Secondary Guard:&lt;/b&gt; Database-level unique constraint &amp;amp; row-level lock fallback&lt;br&gt;• Persistent disk volume &amp;amp; automatic seeding on initial cluster bootstrap&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor:#38BDF8;strokeWidth=2;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="tier5-box">
          <mxGeometry x="800" y="42" width="560" height="95" as="geometry"/>
        </mxCell>

        <!-- ==================== CONNECTORS & DATA FLOW ARROWS ==================== -->
        <!-- Client to Nginx -->
        <mxCell id="edge-client-nginx" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#38BDF8; font-size:11px;'&gt;HTTPS REST (Port 3000) &amp;amp; WSS WebSockets&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#38BDF8;strokeWidth=2;shadow=1;" edge="1" parent="1" source="client-user" target="nginx-lb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-admin-nginx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#818CF8;strokeWidth=2;shadow=1;" edge="1" parent="1" source="client-admin" target="nginx-lb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-loadtest-nginx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#F43F5E;strokeWidth=2;shadow=1;" edge="1" parent="1" source="client-loadtest" target="nginx-lb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Nginx to API Replicas -->
        <mxCell id="edge-nginx-api1" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#10B981; font-size:11px;'&gt;Round-Robin Load Balanced Dispatch&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#10B981;strokeWidth=2;shadow=1;" edge="1" parent="1" source="nginx-lb" target="api-pod-1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-nginx-api2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#10B981;strokeWidth=2;shadow=1;" edge="1" parent="1" source="nginx-lb" target="api-pod-2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-nginx-apin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#10B981;strokeWidth=2;shadow=1;" edge="1" parent="1" source="nginx-lb" target="api-pod-n">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- API to Redis Distributed Lock -->
        <mxCell id="edge-api-redislock" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#EF4444; font-size:11px;'&gt;1. Atomic SET NX PX Lock&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#EF4444;strokeWidth=2;shadow=1;" edge="1" parent="1" source="api-pod-1" target="redis-lock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- API to Redis Pub/Sub -->
        <mxCell id="edge-api-pubsub" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#F59E0B; font-size:11px;'&gt;2. Publish State Change&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#F59E0B;strokeWidth=2;shadow=1;" edge="1" parent="1" source="api-pod-2" target="redis-pubsub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Redis Pub/Sub back to API Pods (Bidirectional) -->
        <mxCell id="edge-pubsub-ws" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#F59E0B; font-size:11px;'&gt;Broadcast to all WS Clients&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.8;entryY=1;entryDx=0;entryDy=0;strokeColor=#F59E0B;strokeWidth=2;dashed=1;shadow=1;" edge="1" parent="1" source="redis-pubsub" target="api-pod-n">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- API to BullMQ -->
        <mxCell id="edge-api-bullmq" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#EC4899; font-size:11px;'&gt;3. Enqueue 5-min Expiration Job&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#EC4899;strokeWidth=2;shadow=1;" edge="1" parent="1" source="api-pod-n" target="bullmq-workers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- BullMQ Auto-Release back to Redis Lock -->
        <mxCell id="edge-bullmq-redislock" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#EC4899; font-size:11px;'&gt;Timeout: DEL seat:lock (Auto-Release)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.85;entryY=1;entryDx=0;entryDy=0;exitX=0.15;exitY=1;exitDx=0;exitDy=0;strokeColor=#EC4899;strokeWidth=2;dashed=1;" edge="1" parent="tier4-box" source="bullmq-workers" target="redis-lock">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="145"/>
              <mxPoint x="405" y="145"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Application Cluster to PgBouncer -->
        <mxCell id="edge-api-pgbouncer" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#06B6D4; font-size:11px;'&gt;4. Multiplexed DB Pool Connections (Port 6432)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#06B6D4;strokeWidth=2;shadow=1;" edge="1" parent="1" source="api-pod-2" target="pgbouncer-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="580"/>
              <mxPoint x="460" y="580"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- PgBouncer to PostgreSQL -->
        <mxCell id="edge-pgbouncer-postgres" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#38BDF8; font-size:11px;'&gt;5. ACID Final Booking Commit (Port 5433)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#38BDF8;strokeWidth=2.5;shadow=1;" edge="1" parent="tier5-box" source="pgbouncer-box" target="postgres-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- BullMQ Async DB Write to PgBouncer -->
        <mxCell id="edge-bullmq-pgbouncer" value="&lt;b style='background-color:#0F172A; padding:2px 4px; color:#EC4899; font-size:11px;'&gt;Async Batch DB Writes&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.8;entryY=0;entryDx=0;entryDy=0;strokeColor=#EC4899;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="bullmq-workers" target="pgbouncer-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
